{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": [
        "run",
        "--project",
        "api/src/FileInviteLite.Api",
        "--",
        "--urls",
        "http://localhost:5080",
        "--ConnectionStrings:Default",
        "Data Source=.local/app-demo.db"
      ],
      "port": 5080
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "web", "run", "dev"],
      "port": 5173
    }
  ]
}
